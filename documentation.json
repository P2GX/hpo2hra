                    "data": "// hra-viewer.component.scss\n.hra-dialog {\n  width: 80vw;\n  max-width: 1000px;\n  border: none;\n  border-radius: 8px;\n  padding: 1.5rem;\n\n  &::backdrop {\n    background: rgb(0 0 0 / 0.5);\n  }\n}",
