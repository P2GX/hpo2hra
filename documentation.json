            "type": "component",
            "sourceCode": "import { ChangeDetectionStrategy, Component, signal, viewChild } from '@angular/core';\nimport { ReactiveFormsModule } from '@angular/forms';\nimport { HraViewerComponent } from '../hra-viewer/hra-viewer.component';\nimport { HraExample } from \"../hra-example/hra-example\";\n\n@Component({\n  selector: 'app-hpo-input-form',\n  standalone: true,\n  imports: [ReactiveFormsModule, HraViewerComponent],\n  templateUrl: './hpo-input-form.html',\n  changeDetection: ChangeDetectionStrategy.OnPush,\n})\nexport default class HpoInputFormComponent {\n\n    hraViewerRef = viewChild.required<HraViewerComponent>('hraViewer');\n  hraViewerOpen = signal(false);\n\n\n    title = signal<string>(\"Emphysema\");\n  hpoExampleTerm = \"HP:0002097\"; // emphysema\n\n  openHraViewer(): void {\n    this.hraViewerRef().open();\n  }\n\n  openHra() {\n    this.hraViewerOpen.set(true);\n    this.openHraViewer();\n}\n\nonHraViewerClosed() {\n    this.hraViewerOpen.set(false);\n  }\n\n}\n",
