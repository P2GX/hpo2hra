            "templateData": "<dialog #dialogEl class=\"hra-dialog\">\n  <h1>{{ title() }}</h1>\n  @if (currentRecord(); as record) {\n   <div>{{ record.termLabel }}</div>\n   <p>{{ record.hpoIri }}</p>\n}\n\n  <button type=\"button\" class=\"btn-outline-cancel\" (click)=\"closeDialog()\">Close</button>\n</dialog>"
