            "type": "component",
            "sourceCode": "import {\n  Component,\n  computed,\n  ElementRef,\n  inject,\n  input,\n  output,\n  signal,\n  viewChild,\n} from '@angular/core';\nimport { HpoMapService } from '../service/hpo-mapper';\nimport { HraRecord } from '../model/model';\n\n\n@Component({\n  selector: 'app-hra-viewer',\n  imports: [],\n  templateUrl: './hra-viewer.component.html',\n  styleUrl: './hra-viewer.component.scss',\n})\nexport class HraViewerComponent {\n    title = input.required<string>();\n    hpo_id = input.required<string>();\n\n    hpoMappingService = inject(HpoMapService);\n    private dialogEl = viewChild.required<ElementRef<HTMLDialogElement>>('dialogEl');\n   \n\n    currentRecord = computed(() => {\n       const termId = this.hpo_id();\n       if (! termId) return null;\n       const hraRecord = this.hpoMappingService.getRecord(termId);\n       if (! hraRecord) return null;\n       return hraRecord();\n    });\n\n    closed = output<void>();\n\n\n    open() {\n        this.dialogEl().nativeElement.show();\n    }\n\n    openHra() {\n      this.open();\n  }\n\n    protected closeDialog() {\n      this.dialogEl().nativeElement.close();\n  }\n\n  onNativeClose() {\n    this.closed.emit();\n  }\n\n\n}",
            "styleUrl": "./hra-viewer.component.scss",
            "assetsDirs": [],
            "styleUrlsData": [
